{
  "name": "opencode-copilot-multipliers",
  "version": "0.1.0",
  "description": "OpenCode plugin that caches GitHub Copilot model multipliers weekly.",
  "keywords": [
    "copilot",
    "github",
    "multipliers",
    "opencode",
    "plugin",
    "pricing"
  ],
  "homepage": "https://github.com/quinus/opencode-copilot-multipliers#readme",
  "bugs": {
    "url": "https://github.com/quinus/opencode-copilot-multipliers/issues"
  },
  "license": "MIT",
  "author": "Quinten Schelfhout",
  "repository": {
    "type": "git",
    "url": "https://github.com/quinus/opencode-copilot-multipliers"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/plugin.js",
  "types": "dist/plugin.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
